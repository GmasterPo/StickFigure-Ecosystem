    "render": "new CanvasRenderer(canvas).draw(pose, { x, y, scale, facing })",
    "combat": "new CombatSession({ fighters: [p1, p2] }).update(dt)",
    "movement": "new PlatformerController({ level }).update(dt, input)",
    "physics": "new Ragdoll({ world }).step(dt) → ragdoll.toPose()"
